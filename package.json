{
  "name": "dawakhana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dawakhana — a lightweight, offline-first point of sale for medicine shops.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "seed": "node server/seed.mjs --force",
    "seed:demo": "node server/seed.mjs --force --demo",
    "typecheck": "tsc -b --noEmit",
    "check:import": "node scripts/check-spreadsheet.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
